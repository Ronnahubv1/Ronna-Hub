local function createToggle(parent, text, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 35)
    frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    frame.Parent = parent
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.65, 0, 1, 0)
    label.Position = UDim2.new(0, 8, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(80, 80, 80)
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.3, 0, 0.7, 0)
    btn.Position = UDim2.new(0.68, 0, 0.15, 0)
    btn.BackgroundColor3 = Color3.fromRGB(220, 50, 50) -- สีแดง (ปิด)
    btn.Text = "ปิด"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 12
    btn.Parent = frame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            btn.BackgroundColor3 = Color3.fromRGB(50, 200, 50) -- สีเขียว (เปิด)
            btn.Text = "เปิด"
        else
            btn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
            btn.Text = "ปิด"
        end
        callback(state, function(newState)
            state = newState
            if state then
                btn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
                btn.Text = "เปิด"
            else
                btn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
                btn.Text = "ปิด"
            end
        end)
    end)
    return frame
end

