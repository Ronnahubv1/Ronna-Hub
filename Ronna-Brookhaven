local walkSpeedConn
createInputToggle(PageMain, "วิ่งเร็ว [1-500]", 16, function(enabled, value)
    if walkSpeedConn then walkSpeedConn:Disconnect() end
    local val = math.clamp(value or 16, 1, 500)
    if enabled then
        walkSpeedConn = RunService.Stepped:Connect(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                LocalPlayer.Character.Humanoid.WalkSpeed = val
            end
        end)
    else
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.WalkSpeed = 16
        end
    end
end)

