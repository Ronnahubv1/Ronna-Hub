    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.26, 0, 0.65, 0)
    btn.Position = UDim2.new(0.71, 0, 0.17, 0)
    btn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    btn.Text = "ปิด"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 12
    btn.Parent = frame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            btn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
            btn.Text = "เปิด"
        else
            btn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
            btn.Text = "ปิด"
        end
        callback(state, tonumber(box.Text) or defaultVal)
    end)
    
    -- พิมพ์ส่งแล้ว รีเซ็ตและปิดอัตโนมัติ
    box.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            state = false
            btn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
            btn.Text = "ปิด"
            callback(false, tonumber(box.Text) or defaultVal)
        end
    end)
end

